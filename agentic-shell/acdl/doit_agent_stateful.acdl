DoitAgentStateful[@T]: {
    Setup {
        S: {
            DOIT_AGENT_ROLE
            COMMAND_TRANSLATION_POLICY
            HISTORY_REFERENCE_POLICY
            SESSION_REFERENCE_POLICY
            MEMORY_USAGE_POLICY
            JSON_OUTPUT_SCHEMA
            env.secure[@T]
        }
    }

    CurrentEnvironment {
        U: {
            env.session_id[@T]
            env.cwd[@T]
            env.secure[@T]
        }
    }

    Memory {
        ForEach(m: sys.user_memories) {
            U: {
                sys.memory.key[m]
                sys.memory.value[m]
                sys.memory.updated_at[m]
            }
        }
    }

    SameSessionHistory {
        ForEach(t: sys.same_session_recent_turns) {
            U: {
                env.user_query[@t]
            }

            A: {
                resp.intent[@t]
                resp.command[@t]
                resp.answer[@t]
                resp.stdout[@t]
                resp.stderr[@t]
                resp.returncode[@t]
            }
        }
    }

    GlobalHistory {
        ForEach(t: sys.global_recent_turns) {
            U: {
                env.session_id[@t]
                env.cwd[@t]
                env.user_query[@t]
            }

            A: {
                resp.intent[@t]
                resp.command[@t]
                resp.stdout_summary[@t]
                resp.stderr_summary[@t]
                resp.returncode[@t]
            }
        }
    }

    CurrentTurn {
        U: {
            env.user_query[@T]
        }
    }

    If env.secure[@T] == true {
        SecurityCheck {
            S: {
                SAFETY_CLASSIFIER_ROLE
                SAFETY_CLASSIFICATION_POLICY
                SAFETY_JSON_OUTPUT_SCHEMA
            }

            U: {
                env.user_query[@T]
                sys.proposed_command[@T]
            }
        }
    }

    If sys.safety.requires_confirmation[@T] == true {
        Confirmation {
            A: {
                sys.proposed_command[@T]
                sys.safety.explanation[@T]
                "Proceed? [y/N]"
            }

            U: {
                env.user_confirmation[@T]
            }
        }
    }

    If sys.execution.allowed[@T] == true {
        Execution {
            T: {
                sys.executed_command[@T]
                sys.stdout[@T]
                sys.stderr[@T]
                sys.returncode[@T]
            }
        }
    }

    StateUpdate {
        T: {
            sys.state_store.append_interaction[@T]
        }
    }
}
