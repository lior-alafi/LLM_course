DoitScenarioModifyingCommandCancelled[@T]: {
    // Invocation {
        U: {
            env.user_query[@T]
            env.cwd[@T]
            env.session_id[@T]
            env.secure[@T]
        }
    //

    // MainAgentLLMCall {
        S: {
            DOIT_AGENT_ROLE
            COMMAND_TRANSLATION_POLICY
            SINGLE_COMMAND_POLICY
            JSON_OUTPUT_SCHEMA
        }

        U: {
            env.user_query[@T]
        }

        A: {
            resp.intent[@T]
            resp.command[@T]
            resp.explanation[@T]
        }
    //

    // RuntimeValidationAndSafety {
        T: {
            sys.single_command_policy.allowed[@T]
            sys.safety.requires_confirmation[@T]
            sys.safety.explanation[@T]
        }
    //

    // UserConfirmation {
        A: {
            sys.confirmation_prompt[@T]
            sys.proposed_command[@T]
        }

        U: {
            env.user_confirmation[@T]
        }

        T: {
            sys.confirmation.accepted[@T]
            sys.execution.skipped[@T]
        }
    //

    // StateAndLogsUpdate {
        T: {
            sys.state_store.append_cancelled_interaction[@T]
            sys.prompt_logger.saved_agent_call[@T]
        }
    //
}
