DoitScenarioSingleCommandPolicyRejection[@T]: {
    // Invocation {
        U: {
            env.user_query[@T]
            env.cwd[@T]
            env.session_id[@T]
        }
    //

    // MainAgentLLMCall {
        S: {
            DOIT_AGENT_ROLE
            COMMAND_TRANSLATION_POLICY
            SINGLE_COMMAND_POLICY
            JSON_OUTPUT_SCHEMA
        }

        U: {
            env.user_query[@T]
        }

        A: {
            resp.intent[@T]
            resp.command[@T]
            resp.explanation[@T]
        }
    //

    // SingleCommandPolicy {
        T: {
            sys.single_command_policy.allowed[@T]
            sys.single_command_policy.reason[@T]
            sys.rejected_command[@T]
        }
    //

    // SafetyAndExecutionSkipped {
        T: {
            sys.safety.not_called[@T]
            sys.execution.skipped[@T]
        }
    //

    // UserVisibleResult {
        A: {
            resp.error[@T]
            resp.explanation[@T]
        }
    //

    // Persistence {
        T: {
            sys.state_store.append_rejected_interaction[@T]
            sys.prompt_logger.saved_agent_call[@T]
        }
    //
}
