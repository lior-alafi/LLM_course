from __future__ import annotations

import argparse

from doit_agent.config import ConfigLoader
from doit_agent.llm_factory import LLMFactory
from doit_agent.agent import DoitAgent
from doit_agent.state.factory import StateStoreFactory
from doit_agent.memory.factory import MemoryStoreFactory
from doit_agent.prompt_log import PromptLogger


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="doit",
        description="LLM shell agent",
    )

    parser.add_argument(
        "-v",
        "--verbose",
        action="count",
        default=0,
        help="Increase verbosity. Use -vv to print full LLM context and response.",
    )

    parser.add_argument(
        "query",
        nargs=argparse.REMAINDER,
        help="Natural language instruction for the agent.",
    )

    return parser.parse_args()


def main() -> int:
    args = parse_args()

    if not args.query:
        print('Usage: doit [-v|-vv] "<your query>"')
        return 1

    query = " ".join(args.query)

    config = ConfigLoader().load()
    llm = LLMFactory.create(config.model)
    state_store = StateStoreFactory.create(config)
    memory_store = MemoryStoreFactory.create(config)

    prompt_logger = PromptLogger(verbose_level=args.verbose)

    agent = DoitAgent(
        config=config,
        llm=llm,
        state_store=state_store,
        memory_store=memory_store,
        prompt_logger=prompt_logger,
        verbose_level=args.verbose,
    )

    return agent.run(query)


if __name__ == "__main__":
    raise SystemExit(main())