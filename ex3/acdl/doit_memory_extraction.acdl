DoitMemoryExtraction[@T]: {
    Setup {
        S: {
            MEMORY_EXTRACTOR_ROLE
            MEMORY_STORAGE_POLICY
            MEMORY_JSON_OUTPUT_SCHEMA
        }
    }

    ExistingMemory {
        ForEach(m: sys.user_memories) {
            U: {
                sys.memory.key[m]
                sys.memory.value[m]
            }
        }
    }

    CurrentTurn {
        U: {
            env.user_query[@T]
        }
    }

    MemoryUpdate {
        If resp.memory.should_store[@T] == true {
            T: {
                sys.memory_store.upsert_memory[@T]
            }
        }
    }
}
